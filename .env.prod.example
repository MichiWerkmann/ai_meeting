# Aurora Minutes – Production Environment
# Diese Datei nach .env.prod kopieren und befüllen.
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# === Image-Tags ===
# Standardmäßig wird :latest vom ghcr.io-Repo gezogen.
# Für gepinnte Versionen z.B. ghcr.io/michiwerkmann/ai-meeting-backend:1.2.3
BACKEND_IMAGE=ghcr.io/michiwerkmann/ai-meeting-backend:latest
FRONTEND_IMAGE=ghcr.io/michiwerkmann/ai-meeting-frontend:latest

# === Reverse-Proxy ===
REVERSE_PROXY_PORT=9443

# === Watchtower ===
# Poll-Intervall in Sekunden (Default: 300 = 5 min)
WATCHTOWER_POLL_INTERVAL=300
TZ=Europe/Berlin

# === Backend / Azure ===
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=germanywestcentral
LLM_AZURE_API_KEY=
LLM_AZURE_ENDPOINT=https://modelle-michi.openai.azure.com
LLM_AZURE_API_VERSION=2025-01-01-preview
LLM_MODEL=gpt-4.1-mini

# === Frontend ===
UI_THEME=meetingai
API_BASE_URL=same-origin
SPEAKER_RECOGNITION_ENABLED=true
SEND_ENABLED=true
